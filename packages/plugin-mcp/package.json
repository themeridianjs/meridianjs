{
  "name": "@meridianjs/plugin-mcp",
  "version": "2.6.0",
  "description": "Meridian plugin: MCP server (Streamable HTTP) so LLM clients can manage tasks via personal access tokens",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@meridianjs/auth": "^2.6.0",
    "@meridianjs/framework": "^2.6.0",
    "@meridianjs/meridian": "^2.6.0",
    "@meridianjs/types": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "tsup": "^8.3.5",
    "tsx": "4.21.0",
    "typescript": "*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
